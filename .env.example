# Self-hosted Supabase on VPS (187.127.113.249)
NEXT_PUBLIC_SUPABASE_URL=http://187.127.113.249:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Adilo (BigCommand) video hosting -------------------------------------
# Used by the Learning Board feature for transparent video upload + streaming.
# Get keys from https://adilo.bigcommand.com/settings/api
ADILO_PUBLIC_KEY=
ADILO_SECRET_KEY=

# --- Bilik AI: Alibaba Model Studio (Qwen), antarabangsa (Singapura) ------
# Kunci dari https://bailian.console.alibabacloud.com/ (DASHSCOPE_API_KEY).
# Tanpa kunci ini laluan ask membalas 503 AI_NOT_CONFIGURED.
DASHSCOPE_API_KEY=

# --- Bilik AI: OpenRouter (dimatikan buat masa ini, KZ-034) ---------------
OPENROUTER_API_KEY=
